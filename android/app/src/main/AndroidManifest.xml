<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Android App Links: claim cardtly.com URLs so taps on NFC
                 tags, deep links, and shared links open the Cardtly app
                 instead of the browser. autoVerify=true makes Android
                 verify against the assetlinks.json hosted at
                 https://cardtly.com/.well-known/assetlinks.json on first
                 install. If verification fails, Android falls back to
                 the chooser dialog. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="cardtly.com" />
                <data android:host="www.cardtly.com" />
            </intent-filter>

            <!-- NFC tag dispatch: when an NDEF tag with a cardtly.com URL
                 is tapped while the app is installed, deliver the tag's
                 URL directly to MainActivity rather than the browser. -->
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="https" android:host="cardtly.com" />
                <data android:scheme="https" android:host="www.cardtly.com" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Host Card Emulation service: lets the phone broadcast the
             user's Cardtly card URL as an NDEF tag when armed via the
             "Tap to share" modal. Other phones (and NFC readers) reading
             standard NDEF tags will pick up the URL and open it.
             The android:permission attribute is required by Android. -->
        <service
            android:name=".CardtlyHceService"
            android:exported="true"
            android:permission="android.permission.BIND_NFC_SERVICE">
            <intent-filter>
                <action android:name="android.nfc.cardemulation.action.HOST_APDU_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.cardemulation.host_apdu_service"
                android:resource="@xml/apduservice" />
        </service>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Contacts plugin: needed for the Save Contact button to write the
         card directly to the user's phone address book. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />

    <!-- NFC plugin: needed to read and write Cardtly NFC tags. Marked as
         optional so the app still installs on devices without NFC hardware
         (cardtly.com browsing still works without it). -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <!-- HCE: phone-to-phone card sharing via Host Card Emulation. Also
         not required so non-HCE Android devices can still install. -->
    <uses-feature android:name="android.hardware.nfc.hce" android:required="false" />

    <!-- Biometric plugin: USE_BIOMETRIC is the modern Android 9+ permission;
         USE_FINGERPRINT is the legacy fallback so older devices still work.
         Both are non-dangerous and don't trigger runtime permission prompts. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
</manifest>
